PORT=5000
# Recommended for local dev: docker compose up -d mongo (from repo root), then use:
MONGODB_URI=mongodb://127.0.0.1:27017/hsshop
# Or MongoDB Atlas (whitelist your IP under Network Access):
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxx.mongodb.net/hsshop?retryWrites=true&w=majority
# Force in-memory DB only (no persistence, re-seeds on restart):
USE_MEMORY_DB=false
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@hsshop.com
ADMIN_PASSWORD=ChangeMe123!
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
CLIENT_URL=http://localhost:3000
